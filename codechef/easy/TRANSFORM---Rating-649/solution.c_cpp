#include <bits/stdc++.h>
using namespace std;

int main() {
   

    int t;
    cin >> t;
    while (t--) {
        int x;
        cin >> x;
        
       
        int rem = x % 3;
        
        if (rem == 0) {
            cout << "NORMAL\n";
        } else if (rem == 1) {
            cout << "HUGE\n";
        } else {
            cout << "SMALL\n";
        }
    }

    return 0;
}