#include <iostream>
#include <cmath>

using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        // sqrt() returns a double, casting to int truncates the decimal part (rounds down)
        int ans = sqrt(n);
        cout << ans << "\n";
    }
    return 0;
}