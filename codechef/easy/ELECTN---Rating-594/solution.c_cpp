#include <bits/stdc++.h>
using namespace std;

int main() {
    // Fast I/O
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int t;
    cin >> t;
    while (t--) {
        int x, a, b;
        cin >> x >> a >> b;

        // Calculate total points: each easy problem is 1 point, each hard is 2 points
        int total_points = a + (2 * b);

        // Check if Chef qualifies
        if (total_points >= x) {
            cout << "Qualify\n";
        } else {
            cout << "NotQualify\n";
        }
    }

    return 0;
}