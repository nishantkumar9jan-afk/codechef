#include <iostream>
using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int b1, b2, b3;
        cin >> b1 >> b2 >> b3;
        
        // If the sum of b1, b2, and b3 is less than or equal to 1,
        // it means at least two bottles are empty (0).
        if (b1 + b2 + b3 <= 1) {
            cout << "Water filling time\n";
        } else {
            cout << "Not now\n";
        }
    }
    return 0;
}