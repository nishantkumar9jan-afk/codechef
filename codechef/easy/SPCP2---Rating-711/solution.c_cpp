#include <bits/stdc++.h>
using namespace std;

void solve() {
    int x;
    cin >> x;
    
    // If x is not divisible by 5, it's impossible to form the amount
    if (x % 5 != 0) {
        cout << -1 << "\n";
    } else {
        // If x is divisible by 5, we maximize 10-rupee coins to minimize total coins
        cout << (x + 5) / 10 << "\n";
    }
}

int main() {
    // Fast I/O
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    
    return 0;
}