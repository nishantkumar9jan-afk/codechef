#include <iostream>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int N;
        cin >> N;

        int last = N % 10;

        while (N >= 10) {
            N /= 10;
        }

        int first = N;

        cout << first + last << endl;
    }

    return 0;
}