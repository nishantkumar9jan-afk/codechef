#include <bits/stdc++.h>
using namespace std;

int main() {
    // Fast I/O
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int T;
    cin >> T;
    while (T--) {
        int X, Y, D;
        cin >> X >> Y >> D;

        // Check if the absolute difference is less than or equal to D
        if (abs(X - Y) <= D) {
            cout << "YES\n";
        } else {
            cout << "NO\n";
        }
    }

    return 0;
}