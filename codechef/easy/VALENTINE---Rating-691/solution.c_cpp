#include <bits/stdc++.h>
using namespace std;

int main() {
    // Fast I/O
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int t;
    cin >> t;
    while (t--) {
        int x, y;
        cin >> x >> y;
        // The maximum chocolates Chef can buy is X divided by Y
        cout << x / y << "\n";
    }

    return 0;
}