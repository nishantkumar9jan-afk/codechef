#include <bits/stdc++.h>
using namespace std;

int main() {
    
    int t;
    cin >> t;
    while (t--) {
        int p, q;
        cin >> p >> q;
        
       
        int total_serves = p + q;
        
       
        int turns = total_serves / 2;
        
        if (turns % 2 == 0) {
            cout << "Alice\n";
        } else {
            cout << "Bob\n";
        }
    }
    return 0;
}