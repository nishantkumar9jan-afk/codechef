#include <bits/stdc++.h>
using namespace std;

void solve() {
    int p, q, r, s;
    cin >> p >> q >> r >> s;
    
    int total_sum = p + q + r + s;
    int max_profit = max({p, q, r, s});
    
    if (2 * max_profit > total_sum) {
        cout << "YES\n";
    } else {
        cout << "NO\n";
    }
}

int main() {
    // Fast I/O
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    
    return 0;
}