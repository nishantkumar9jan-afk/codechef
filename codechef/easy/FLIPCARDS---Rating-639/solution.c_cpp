#include <bits/stdc++.h>
using namespace std;

void solve() {
    int x, y;
    cin >> x >> y;
    // The time taken is the absolute difference between their positions
    cout << abs(x - y) << "\n";
}

int main() {
   
 
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    return 0;
}