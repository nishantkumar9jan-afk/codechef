#include <iostream>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        long long A, B;
        cin >> A >> B;

        long long firstVal = 10 * A;
        long long secondVal = 5 * B;

        if (firstVal > secondVal)
            cout << "FIRST\n";
        else if (firstVal < secondVal)
            cout << "SECOND\n";
        else
            cout << "ANY\n";
    }

    return 0;
}