#include <bits/stdc++.h>
using namespace std;

int main() {
    // Fast I/O
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int t;
    cin >> t;
    while (t--) {
        int n, k, m;
        cin >> n >> k >> m;
        
        // Capacity of a single bag
        int bag_capacity = k * m;
        
        // Calculate minimum bags needed
        int bags = (n + bag_capacity - 1) / bag_capacity;
        
        cout << bags << "\n";
    }

    return 0;
}