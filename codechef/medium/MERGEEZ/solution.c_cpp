
#include <bits/stdc++.h>
using namespace std;

const int MOD = 998244353;

int main() {
ios::sync_with_stdio(false);
cin.tie(nullptr);

int T;
cin >> T;

while (T--) {
    int N;
    cin >> N;

    vector<int> P(N);
    for (int i = 0; i < N; i++) {
        cin >> P[i];
    }

    vector<int> dp(N + 1, 0);
    dp[0] = 1;

    for (int i = 0; i < N; i++) {
        for (int j = i; j >= 0; j--) {
            dp[j + 1] = (dp[j + 1] + dp[j]) % MOD;
        }
    }

    for (int i = 0; i <= N; i++) {
        cout << dp[i] << (i == N ? '\n' : ' ');
    }
}

return 0;

}