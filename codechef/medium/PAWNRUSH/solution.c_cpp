#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int R;
    if (cin >> R) {
        if (R == 2) {
            // First move goes 2 rows (to row 4), then 4 single-row moves (4 -> 5 -> 6 -> 7 -> 8)
            cout << 5 << '\n';
        } else {
            // From any row R > 2, each move advances 1 row up to row 8
            cout << (8 - R) << '\n';
        }
    }

    return 0;
}