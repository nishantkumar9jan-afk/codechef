#include <iostream>
using namespace std;

int main() {
    int t;
    cin >> t;
    
    while (t > 0) {
        int n, k;
        cin >> n >> k;
        
        int c[105]; 
        for (int i = 1; i <= n; i++) {
            cin >> c[i];
        }
        
        int ans = -1; 
        
        
        for (int i = 1; i <= n; i++) {
            for (int j = i + 1; j <= n; j++) {
                
                
                bool left_cover = (i - k <= 1);
                
               
                bool right_cover = (j + k >= n);
                
              
                bool middle_cover = (i + k + 1 >= j - k);
                
               
                if (left_cover && right_cover && middle_cover) {
                    int current_cost = c[i] + c[j];
                    
                    
                    if (ans == -1 || current_cost < ans) {
                        ans = current_cost;
                    }
                }
            }
        }
        
        cout << ans << endl; 
        t--;
    }
    
    return 0;
}