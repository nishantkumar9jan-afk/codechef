
#include <bits/stdc++.h>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int N;
        string S;
        cin >> N >> S;

        int count = 0, ans = 0;
        char prev = '\0';

        for (int i = 0; i < N; i++) {
            if (S[i] != prev) {
                count = 0;
            }

            count++;

            if (count == 3) {
                ans++;
                count = 0;
            }

            prev = S[i];
        }

        cout << ans << endl;
    }

    return 0;
}

