
#include <bits/stdc++.h>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int N;
        string S;
        cin >> N >> S;

        int count = 0, ans = 0;

        for (int i = 0; i < N; i++) {
            count++;

            if (i + 1 < N && S[i] != S[i + 1]) {
                count = 0;
            }

            if (count == 3) {
                ans++;
                count = 0;
            }
        }

        cout << ans << endl;
    }

    return 0;
}

