#include <iostream>
#include <string>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int N;
        string A, B;

        cin >> N >> A >> B;

        int aA = 0, aB = 0;

        for (char c : A)
            if (c == 'a') aA++;

        for (char c : B)
            if (c == 'a') aB++;

        int bA = N - aA;
        int bB = N - aB;

        if (aA <= bB && bA <= aB)
            cout << "YES\n";
        else
            cout << "NO\n";
    }

    return 0;
}