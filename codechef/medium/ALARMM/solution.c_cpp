#include <bits/stdc++.h>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int N, K;
        cin >> N >> K;

        string S;
        cin >> S;

        int ans = 0;
        int i = 0;

        while (i < N) {
            if (S[i] == '1') {
                ans++;
                i += K + 1;
            } else {
                i++;
            }
        }

        cout << ans << endl;
    }

    return 0;
}