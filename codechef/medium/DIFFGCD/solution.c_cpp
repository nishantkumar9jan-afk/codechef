#include <bits/stdc++.h>
using namespace std;

using ll = long long;

ll solve(ll N) {
ll ans = 0;

```
for (ll d = 1; d <= N / 2; d++) {
    ans += N / d - 1;
}

return ans;
```

}

int main() {
ios::sync_with_stdio(false);
cin.tie(nullptr);

```
int T;
cin >> T;

while (T--) {
    ll N;
    cin >> N;
    cout << solve(N) << '\n';
}

return 0;
```

}
