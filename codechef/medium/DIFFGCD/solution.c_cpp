#include <bits/stdc++.h>
using namespace std;

int main() {
ios::sync_with_stdio(false);
cin.tie(nullptr);

```
int T;
cin >> T;

while (T--) {
    long long N;
    cin >> N;

    long long ans = 0;

    for (long long X = 1; X <= N; X++) {
        ans += (N / X - 1);
    }

    cout << ans << '\n';
}

return 0;
```

}
