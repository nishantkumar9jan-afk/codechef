#include <bits/stdc++.h>
using namespace std;

using ll = long long;

ll solve(ll N) {
ll M = N / 2;
ll sum = 0;

```
for (ll l = 1, r; l <= M; l = r + 1) {
    ll q = N / l;
    r = min(M, N / q);

    sum += q * (r - l + 1);
}

return sum - M;
```

}

int main() {
ios::sync_with_stdio(false);
cin.tie(nullptr);

```
int T;
cin >> T;

while (T--) {
    ll N;
    cin >> N;

    cout << solve(N) << '\n';
}

return 0;
```

}
