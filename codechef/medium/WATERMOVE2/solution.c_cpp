#include <bits/stdc++.h>
using namespace std;

void solve() {
    int n, k;
    cin >> n >> k;
    vector<long long> a(n);
    long long total_sum = 0;
    for (int i = 0; i < n; i++) {
        cin >> a[i];
        total_sum += a[i];
    }
    

    
    if (k >= n - 1) {
        cout << total_sum << "\n";
    } else {
        sort(a.rbegin(), a.rend());
        long long current_sum = 0;
      
        for (int i = 0; i <= k; i++) {
            current_sum += a[i];
        }
        cout << current_sum << "\n";
    }
}

int main() {
 
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    return 0;
}