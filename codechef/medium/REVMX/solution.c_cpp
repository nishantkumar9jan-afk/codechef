#include <bits/stdc++.h>
using namespace std;

void solve() {
    int N;
    cin >> N;

    vector<int> P(N + 1);
    int fixed = 0;

    for (int i = 1; i <= N; i++) {
        cin >> P[i];
        if (P[i] == i) fixed++;
    }

    int ans = fixed;

    for (int L = 1; L <= N; L++) {
        for (int R = L; R <= N; R++) {
            int cnt = fixed;

            for (int i = L; i <= R; i++) {
                if (P[i] == i) cnt--;
                if (P[i] == L + R - i) cnt++;
            }

            ans = max(ans, cnt);
        }
    }

    cout << ans << '\n';
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int T;
    cin >> T;

    while (T--) {
        solve();
    }

    return 0;
}