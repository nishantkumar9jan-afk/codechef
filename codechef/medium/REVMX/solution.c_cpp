#include <bits/stdc++.h>
using namespace std;

void solve() {
    int N;
    cin >> N;

    vector<int> P(N + 1);
    vector<int> pref(N + 1, 0);
    vector<int> sum(N + 1);

    int fixed = 0;

    for (int i = 1; i <= N; i++) {
        cin >> P[i];
        sum[i] = i + P[i];

        if (P[i] == i) {
            fixed++;
        }

        pref[i] = pref[i - 1] + (P[i] == i);
    }

    int ans = fixed;

    for (int L = 1; L <= N; L++) {
        vector<int> freq(2 * N + 2, 0);

        for (int R = L; R <= N; R++) {
            freq[sum[R]]++;

            int S = L + R;
            int insideFixed = pref[R] - pref[L - 1];

            int current = fixed - insideFixed + freq[S];

            ans = max(ans, current);
        }
    }

    cout << ans << '\n';
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int T;
    cin >> T;

    while (T--) {
        solve();
    }

    return 0;
}