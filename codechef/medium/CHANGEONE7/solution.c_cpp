#include <bits/stdc++.h>
using namespace std;

void solve() {
    int n;
    cin >> n;
    vector<int> a(n);
    for (int i = 0; i < n; i++) {
        cin >> a[i];
    }
    
    sort(a.begin(), a.end());
    

    int ans = min(a[n - 1] - a[1], a[n - 2] - a[0]);
    cout << ans << "\n";
}

int main() {
 
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    return 0;
}
