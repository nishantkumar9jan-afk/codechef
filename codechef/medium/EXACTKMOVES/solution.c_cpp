#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int T;
    if (!(cin >> T)) return 0;

    while (T--) {
        long long N, K;
        cin >> N >> K;

        long long min_steps = K;
        long long max_steps = 2 * K;

        if (min_steps <= N && N <= max_steps) {
            cout << "YES\n";
        } else {
            cout << "NO\n";
        }
    }

    return 0;
}