
#include <bits/stdc++.h>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int N;
        cin >> N;

        vector<long long> A(N);

        for (int i = 0; i < N; i++) {
            cin >> A[i];
        }

        long long ans = A[N - 1] - A[N - 2];

        for (int i = 0; i < N - 2; i++) {
            ans += abs(A[i]);
        }

        cout << ans << '\n';
    }

    return 0;
}
